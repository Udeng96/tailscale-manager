{
  "name": "tailscale-manager",
  "private": true,
  "version": "0.1.0",
  "description": "울산 프로젝트용 Tailscale·SSH 터널·DB 연결 관리 도구",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n web,app -c green,blue \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "kr.ulsan.tailscale-manager",
    "productName": "Tailscale Manager",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Tailscale Manager",
        "schemes": [
          "tailscale-manager"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
